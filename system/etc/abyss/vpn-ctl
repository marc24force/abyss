#!/bin/sh

# vpn-ctl — privileged backend for the "vpn" CLI; the ONLY command exposed
# through sudoers (sudoers.d/30-vpn, %network). Profiles live in the
# invoking user's ~/.config/vpn/<name>/{vpn.conf,secret}; per-profile
# runit services are generated host-side (never in the rice repo):
#
#   up <name>      start now. auth=otp profiles read two lines on stdin
#                  first (password, one-time code) and stage them for
#                  vpn-run. Only one VPN runs at a time: others stop.
#   down <name>    stop now
#   on <name>      auto-start at boot (single active: others demoted)
#   off <name>     no auto-start at boot
#   forget <name>  remove the generated service + state (the profile
#                  files themselves are the user's business)
#
# Auto-start is plain runit: the /var/service link decides whether a
# profile runs at boot; a "down" file in the generated unit marks
# manual-only profiles (linked for supervision, not started at boot).

PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL

svc_root=/etc/sv
farm=/var/service
run=/run/vpn

die() { echo "vpn-ctl: $*" >&2; exit 1; }

usage() {
	echo "usage: vpn-ctl up|down|on|off|forget <profile>" >&2
	exit 2
}

[ "$(id -u)" = 0 ] || die "must run as root (via sudo)"
user=${SUDO_USER:-}
[ -n "$user" ] || die "run through sudo"
home=$(getent passwd "$user" | cut -d: -f6)
[ -n "$home" ] || die "no home directory for $user"

valid_name() {
	case "$1" in
		'' | status | -* | .* | *[!a-zA-Z0-9._-]*) return 1 ;;
		*) return 0 ;;
	esac
}

prof_conf() { printf '%s/.config/vpn/%s/vpn.conf' "$home" "$1"; }
svc_dir() { printf '%s/vpn-%s' "$svc_root" "$1"; }
linked() { [ -L "$farm/vpn-$1" ]; }

require_profile() {
	valid_name "$1" || die "bad profile name: $1"
	[ -r "$(prof_conf "$1")" ] || die "no profile $1 (vpn add $1?)"
	grep -q '^host=' "$(prof_conf "$1")" || die "profile $1 has no host="
}

# openresolv only updates a resolv.conf carrying its own signature; a
# foreign file makes every resolvconf update silently no-op. Reclaim it
# before connecting (the old file is kept as /etc/resolv.conf.bak).
resolvconf_reclaim() {
	[ -f /etc/resolv.conf ] || return 0
	head -n 1 /etc/resolv.conf 2>/dev/null |
		grep -qx '# Generated by resolvconf' && return 0
	resolvconf -u >/dev/null 2>&1
	if head -n 1 /etc/resolv.conf 2>/dev/null |
		grep -qx '# Generated by resolvconf'; then
		echo "vpn-ctl: reclaimed /etc/resolv.conf for resolvconf" >&2
	else
		echo "vpn-ctl: warning: could not reclaim /etc/resolv.conf" >&2
	fi
}

gen_service() {
	# $1 = name; (re)writes /etc/sv/vpn-<name>/run
	conf=$(prof_conf "$1")
	dir=$(svc_dir "$1")
	mkdir -p "$dir"
	q=$(printf '%s' "$conf" | sed "s/'/'\\\\''/g")
	{
		printf '%s\n' '#!/bin/sh'
		printf '%s\n' "# generated by vpn-ctl for $1 — edit the profile, not this"
		printf "exec /etc/abyss/vpn-run '%s'\n" "$q"
	} > "$dir/run.new"
	chmod 755 "$dir/run.new" && mv -f "$dir/run.new" "$dir/run"
}

link_service() {
	# $1 = name, $2 = manual (1: add a down file so boot does not auto-start)
	ln -s "$(svc_dir "$1")" "$farm/vpn-$1"
	[ "$2" = 1 ] && touch "$(svc_dir "$1")/down"
	# wait for runsvdir to spawn runsv (it scans every ~5 s)
	i=0
	while [ ! -e "$farm/vpn-$1/supervise/ok" ]; do
		i=$((i + 1))
		[ "$i" -ge 16 ] && return 0
		sleep 0.5
	done
}

down_others() {
	for s in "$farm"/vpn-*; do
		[ -d "$s" ] || continue
		n=${s##*/}
		n=${n#vpn-}
		[ "$n" = "$1" ] && continue
		sv down "$s" >/dev/null 2>&1
	done
}

cmd_up() {
	require_profile "$1" || exit 1
	resolvconf_reclaim
	auth=$(sed -n 's/^auth=//p' "$(prof_conf "$1")" | head -n 1)
	if [ "$auth" = otp ]; then
		# the CLI collects password + one-time code and pipes them here;
		# they are staged for vpn-run and never appear in argv
		pw= code=
		IFS= read -r pw
		IFS= read -r code
		[ -n "$pw" ] || die "no password on stdin"
		mkdir -p "$run"
		umask 077
		printf '%s\n%s\n' "$pw" "$code" > "$run/$1.secret"
	fi
	gen_service "$1"
	linked "$1" || link_service "$1" 1
	down_others "$1"
	rm -f "$run/$1.tries"
	sv restart "$farm/vpn-$1" >/dev/null 2>&1
}

cmd_down() {
	valid_name "$1" || die "bad profile name: $1"
	if linked "$1"; then
		sv down "$farm/vpn-$1" >/dev/null 2>&1
	fi
	/etc/abyss/vpn-state "$1" down
}

cmd_on() {
	require_profile "$1" || exit 1
	resolvconf_reclaim
	gen_service "$1"
	linked "$1" || link_service "$1" 0
	# single active at boot: demote every other profile's auto-start
	for s in "$farm"/vpn-*; do
		[ -d "$s" ] || continue
		n=${s##*/}
		n=${n#vpn-}
		[ "$n" = "$1" ] && continue
		touch "$(svc_dir "$n")/down"
		sv down "$s" >/dev/null 2>&1
	done
	rm -f "$(svc_dir "$1")/down" "$run/$1.tries"
	sv up "$farm/vpn-$1" >/dev/null 2>&1
}

cmd_off() {
	valid_name "$1" || die "bad profile name: $1"
	if linked "$1"; then
		sv down "$farm/vpn-$1" >/dev/null 2>&1
	fi
	[ -d "$(svc_dir "$1")" ] && touch "$(svc_dir "$1")/down"
	/etc/abyss/vpn-state "$1" down
}

cmd_forget() {
	valid_name "$1" || die "bad profile name: $1"
	if linked "$1"; then
		sv down "$farm/vpn-$1" >/dev/null 2>&1
		rm -f "$farm/vpn-$1"
	fi
	rm -rf "$(svc_dir "$1")"
	rm -f "$run/$1" "$run/$1".*
	/etc/abyss/vpn-state --regen
}

[ $# -eq 2 ] || usage
cmd=$1
name=$2

case "$cmd" in
	up) cmd_up "$name" ;;
	down) cmd_down "$name" ;;
	on) cmd_on "$name" ;;
	off) cmd_off "$name" ;;
	forget) cmd_forget "$name" ;;
	*) usage ;;
esac
