#!/bin/sh

# Locate the machine by IP and cache the coordinates.
# Writes "<lat> <lon>" to /var/cache/location (world-readable, atomic)
# and re-fetches after $refresh, backing off $retry on failure.

[ -r ./conf ] && . ./conf

: "${refresh:=14d}"
: "${retry:=5m}"

cache=/var/cache/location
tmp="$cache.new"

is_coord() {
	# "<lat> <lon>", optional sign and decimals
	printf '%s\n' "$1" | awk -v FS=' ' \
		'NF == 2 \
		 && $1 ~ /^-?[0-9]+(\.[0-9]+)?$/ \
		 && $2 ~ /^-?[0-9]+(\.[0-9]+)?$/ \
		 { ok = 1 } END { exit !ok }'
}

while :; do
	# ipinfo.io answers "lat,lon"; ip-api.com answers one field per line
	latlon=$(curl -fsS --max-time 10 https://ipinfo.io/loc 2>/dev/null | sed 's/,/ /')
	if ! is_coord "$latlon"; then
		latlon=$(curl -fsS --max-time 10 'http://ip-api.com/line/?fields=lat,lon' 2>/dev/null | paste -d ' ' - -)
	fi

	if is_coord "$latlon"; then
		printf '%s\n' "$latlon" > "$tmp" \
			&& chmod 644 "$tmp" \
			&& mv -f "$tmp" "$cache" \
			&& { sleep "$refresh"; continue; }
		rm -f "$tmp"
	fi

	sleep "$retry"
done
